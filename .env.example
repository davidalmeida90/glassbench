# Copy to .env at the repository root. Only these names are read (deskapp/settings.py KEY_ALLOWLIST);
# values stay in the backend process and never reach the browser.

# The LLM provider you pick in the New run dialog needs its key here (DeepSeek is the default).
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
MINIMAX_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Ollama needs no key; set this only if it is not on http://localhost:11434
OLLAMA_BASE_URL=

# Data
FRED_API_KEY=
SEC_EDGAR_EMAIL=

# Alpaca paper trading, optional (Settings page)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# AI Hedge Fund (optional second framework): all its data comes from financialdatasets.ai.
# The key is free; the data needs prepaid credits (about $0.02 a request).
FINANCIAL_DATASETS_API_KEY=
# Optional: TypeSafe's Jev as the model behind AI Hedge Fund's analysts.
TYPESAFE_API_KEY=
